# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/extract_db

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# NuExtract (Primary) - Choose ONE:
# Option 1: NuMind Platform API (recommended for production)
NUMIND_API_KEY=your_numind_api_key

# Option 2: Local model (for privacy/offline use)
NUEXTRACT_USE_LOCAL=false
NUEXTRACT_MODEL=numind/NuExtract-1.5
NUEXTRACT_DEVICE=cuda  # cuda, cpu, or mps

# LlamaExtract (Fallback)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

# Extraction Provider: auto, nuextract_api, nuextract_local, llamaextract
EXTRACTION_PROVIDER=auto

# OpenAI (for embeddings and chat)
OPENAI_API_KEY=your_openai_api_key
